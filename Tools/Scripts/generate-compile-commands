# Script to generate compile_commands.json file

import argparse
import glob
import json
import os
import re
import subprocess
import sys
import tempfile

OUTPUT_FILE = 'compile_commands.json'
THIRD_PARTY_DIRECTORY = os.path.join('Source', 'ThirdParty')

# `CompileC <output> <source> <variant> <arch> <language> <compiler identifier>`
COMPILE_TASK_RE = re.compile(r'"CompileC (?P<output>[^"]*?\.o) (?P<source>[^"]*?) \S+ \S+ \S+ \S+"')

# Enough to hold the longest description a chunk boundary could split.
MAX_DESCRIPTION_LENGTH = 8192


def expand_unified_sources(entries, source_dir, build_dir):
    """Expands the UnifiedSource entries into the sources they bundle.

    rewrite-compile-commands already does this for the CMake ports, so run it
    rather than growing a second copy of it here.
    """
    script = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                          'rewrite-compile-commands')

    with tempfile.TemporaryDirectory() as temporary_dir:
        input_file = os.path.join(temporary_dir, OUTPUT_FILE)
        output_file = os.path.join(temporary_dir, 'expanded', OUTPUT_FILE)

        with open(input_file, 'w') as unexpanded:
            json.dump(entries, unexpanded)

        subprocess.check_call([sys.executable, script, input_file,
                               output_file, source_dir, build_dir])

        with open(output_file) as expanded:
            return json.load(expanded)


def stale_fragments(records):
    """Returns the fragments that no longer describe how the tree is built.

    Nothing ever removes a fragment, and its name carries a hash of the command,
    so editing a build setting leaves the pre-edit fragment behind next to the
    new one. Both then describe the same object with contradictory flags.
    """
    # A compilation database may state file and output relative to directory.
    def absolute(entry, name):
        path = entry.get(name)
        return os.path.join(entry.get('directory', ''), path) if path else None

    newest = {}
    for fragment_file, entry in records:
        output = absolute(entry, 'output')
        if output is None:
            continue
        modified = os.path.getmtime(fragment_file)
        if output not in newest or modified > newest[output][1]:
            newest[output] = (fragment_file, modified)
    current = set(fragment_file for fragment_file, _ in newest.values())

    missing_source = []
    superseded = []
    for fragment_file, entry in records:
        if not os.path.exists(absolute(entry, 'file')):
            missing_source.append(fragment_file)
        elif entry.get('output') is not None and fragment_file not in current:
            superseded.append(fragment_file)

    return missing_source, superseded


def compile_task_sources(manifest_file):
    """Returns the sources of every compile task described by an llbuild manifest.

    These manifests reach hundreds of megabytes, so scan them in chunks rather
    than parsing them as JSON.
    """
    sources = set()
    overlap = ''

    with open(manifest_file, encoding='utf-8', errors='replace') as manifest:
        while True:
            chunk = manifest.read(8 * 1024 * 1024)
            if not chunk:
                break
            text = overlap + chunk
            for match in COMPILE_TASK_RE.finditer(text):
                sources.add(match.group('source'))
            overlap = text[-MAX_DESCRIPTION_LENGTH:]

    return sources


def build_graph_sources(built_products_dir):
    """Returns every source the Xcode build graph compiles, or None if it cannot be read.

    Xcode records its whole build graph, including the files that are already
    up to date, so it tells us which compile commands the build directory is
    missing.
    """
    built_products_dir = os.path.abspath(built_products_dir)
    xcbuild_data_dir = os.path.join(os.path.dirname(built_products_dir), 'XCBuildData')
    if not os.path.isdir(xcbuild_data_dir):
        return None

    configuration = os.path.basename(built_products_dir)
    symroot = os.path.dirname(built_products_dir)

    # Every build writes its own manifest, and a project built by a separate
    # xcodebuild invocation (build-imagediff, for one) writes its own as well.
    # Keep the newest manifest of every project matching this build directory.
    manifest_files = {}
    for request_file in glob.glob(os.path.join(xcbuild_data_dir, '*.xcbuilddata', 'build-request.json')):
        try:
            with open(request_file) as request:
                build_request = json.load(request)
            parameters = build_request['parameters']
            if parameters['configurationName'] != configuration:
                continue
            if os.path.abspath(parameters['overrides']['commandLine']['table']['SYMROOT']) != symroot:
                continue
            container = build_request['containerPath']
        except (KeyError, ValueError, OSError):
            continue

        manifest_file = os.path.join(os.path.dirname(request_file), 'manifest.json')
        if not os.path.exists(manifest_file):
            continue

        newest = manifest_files.get(container)
        if newest is None or os.path.getmtime(manifest_file) > os.path.getmtime(newest):
            manifest_files[container] = manifest_file

    if not manifest_files:
        return None

    sources = set()
    for manifest_file in manifest_files.values():
        sources |= compile_task_sources(manifest_file)

    return sources or None


def warn_about_missing_compile_commands(missing, graph_size):
    counts = {}
    for source in missing:
        directory = os.path.dirname(os.path.relpath(source))
        directory = os.path.sep.join(directory.split(os.path.sep)[:2])
        counts[directory] = counts.get(directory, 0) + 1

    lines = ['', 'Warning: %d of the %d compile tasks in the Xcode build graph '
                 'wrote no compile commands:' % (len(missing), graph_size)]
    for directory, count in sorted(counts.items(), key=lambda item: -item[1])[:10]:
        lines.append('    %6d  %s' % (count, directory))
    if len(counts) > 10:
        lines.append('    (and %d more directories)' % (len(counts) - 10))
    lines += ['Only the files a build compiles write compile commands. '
              'Build from scratch to cover them all:',
              '    rm -rf ./WebKitBuild',
              '    Tools/Scripts/build-webkit --export-compile-commands']

    print('\n'.join(lines))


# Get command line args
parser = argparse.ArgumentParser(description='Generate compile_commands.json for Xcode builds',
            usage="""
                  make r EXPORT_COMPILE_COMMANDS=YES
                  generate-compile-commands WebKitBuild/Release

                  https://docs.webkit.org/Build%%20%%26%%20Debug/BuildOptions.html#building-with-compile_commandsjson
                  """)

parser.add_argument('built_products_dir', metavar='built-products-dir', help='path to the build directory containing generated compile commands (ex: WebKitBuild/Release)')
parser.add_argument('--delete-invalid', action='store_true', help='Delete any invalid json file')
parser.add_argument('--delete-stale', action='store_true', help='Delete any stale json file')
parser.add_argument('--include-third-party', action='store_true', help='Include code in Source/ThirdParty')
opts = parser.parse_args()

# Change to the root of WebKit Directory
file_dir = os.path.dirname(os.path.realpath(__file__))
base_dir = file_dir + "/../../"
os.chdir(base_dir)

# Check compile_commands folder exists
compile_commands_dir = opts.built_products_dir + "/compile_commands/"

if not os.path.exists(compile_commands_dir):
    is_cmake_build = os.path.exists(opts.built_products_dir + "/CMakeCache.txt")
    if is_cmake_build:
        print("The build directory passed seems to be a CMake build.")
        print("This script is only used for Xcode builds.")
        print("For CMake builds use -DCMAKE_EXPORT_COMPILE_COMMANDS=ON instead "
              "(this is already the default when using -DDEVELOPER_MODE=ON with Makefile and Ninja generators).")
    else:
        print("Please specify the build directory with compile_commands.")
        print("Example: generate-compile-commands WebKitBuild/Release")
    exit(1)

# Generate compile_commands.json

# For things not to horribly break for users during normal use we need to validate the compiler is spitting out
# valid json files. Sometimes if a compile error happens or the user stops the build part way through
# there will be a very invalid json file sitting in the directory. When we go to bundle it up into the final
# compile_commands.json file, we now have an invalid compile_commands.json file and clangd will not work.
# To prevent this from happening we should check that every json file we add is valid, and also ensure there are no
# duplicate entries.

records = []
seen_entries = set()

for j_file_name in sorted(glob.glob(compile_commands_dir + "/*.json")):
    with open(j_file_name, "r") as j_file:
        json_contents = j_file.read()

    # Each fragment is written to be concatenated with the others, so it ends with a comma.
    json_contents = json_contents.rstrip().rstrip(',')

    # Try to load JSON File
    try:
        entry = json.loads(json_contents)
    except Exception:
        if opts.delete_invalid:
            os.remove(j_file_name)
            print("Deleted invalid JSON File: " + j_file_name)
        else:
            print("Invalid JSON File: " + j_file_name)
        continue

    # Match the file being compiled, not the flags, so that first party code
    # including a third party header is kept.
    if not opts.include_third_party and THIRD_PARTY_DIRECTORY in entry.get('file', ''):
        continue

    if json_contents in seen_entries:
        continue
    seen_entries.add(json_contents)
    records.append((j_file_name, entry))

missing_source, superseded = stale_fragments(records)
stale = set(missing_source) | set(superseded)

if opts.delete_stale:
    for j_file_name in sorted(stale):
        os.remove(j_file_name)
        print("Deleted stale JSON File: " + j_file_name)

entries = [entry for j_file_name, entry in records if j_file_name not in stale]

# The build graph describes the bundles, so compare before expanding them.
compiled_sources = set(entry['file'] for entry in entries)

unified_source_count = sum(1 for entry in entries if 'UnifiedSource' in entry['file'])
direct_entry_count = len(entries) - unified_source_count
expanded_entry_count = 0

# Xcode only bundles sources when unified builds are enabled, so let the build
# itself say whether there is anything to expand.
if unified_source_count:
    entries = expand_unified_sources(entries, os.path.abspath(base_dir),
                                     os.path.abspath(opts.built_products_dir))
    expanded_entry_count = len(entries) - direct_entry_count

# Write the new compile_commands.json file
with open(OUTPUT_FILE, 'w') as new_compile_commands_file:
    new_compile_commands_file.write("[")
    for index, entry in enumerate(entries):
        if index != 0:
            new_compile_commands_file.write(",\n")
        else:
            new_compile_commands_file.write("\n")
        new_compile_commands_file.write(json.dumps(entry))
    new_compile_commands_file.write("\n]\n")

summary = "Generated Compile Commands! %d entries" % len(entries)
if expanded_entry_count:
    summary += "\n  (%d direct, %d expanded from %d unified sources)" \
               % (direct_entry_count, expanded_entry_count, unified_source_count)
if stale:
    summary += "\n  (%d stale fragment(s): %d missing source, %d superseded)" \
               % (len(stale), len(missing_source), len(superseded))
print(summary)

graph_sources = build_graph_sources(opts.built_products_dir)
if graph_sources is not None:
    if not opts.include_third_party:
        graph_sources = set(s for s in graph_sources if THIRD_PARTY_DIRECTORY not in s)
    missing = graph_sources - compiled_sources
    if missing:
        warn_about_missing_compile_commands(missing, len(graph_sources))
